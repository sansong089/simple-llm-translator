{
  "manifest_version": 3,
  "name": "Simple LLM Translator",
  "version": "0.1.0",
  "description": "Translate webpage DOM text with a user-configured OpenAI-compatible API.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Simple LLM Translator",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
